<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PesanMakanan" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_PesanMakanan">
    <bpmn:participant id="Participant_PesanMakanan" name="Pesan Makanan Online" processRef="pesan-makanan" />
  </bpmn:collaboration>
  <bpmn:process id="pesan-makanan" name="Pesan Makanan Online" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_PesanMakanan">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_CustomerPesan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem">
        <bpmn:flowNodeRef>Task_HitungOngkir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProsesPembayaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MulaiParalel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CariDriver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DriverDitemukan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_BatasWaktuDriver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TungguHasil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Gagal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefundPembayaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PesananDibatalkan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Restoran" name="Restoran">
        <bpmn:flowNodeRef>Task_KonfirmasiRestoran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RestoranHasil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_BatasWaktuRestoran</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Driver" name="Driver">
        <bpmn:flowNodeRef>Task_AntarPesanan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PesananSelesai</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_CustomerPesan" name="Customer Pesan" camunda:formRef="start-pesanan" camunda:formRefBinding="deployment" camunda:initiator="initiator">
      <bpmn:outgoing>Flow_Start_HitungOngkir</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_HitungOngkir" name="Hitung Ongkir &#38; Total Harga" camunda:type="external" camunda:topic="hitung-ongkir">
      <bpmn:incoming>Flow_Start_HitungOngkir</bpmn:incoming>
      <bpmn:outgoing>Flow_HitungOngkir_Pembayaran</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ProsesPembayaran" name="Proses Pembayaran" camunda:type="external" camunda:topic="proses-pembayaran">
      <bpmn:incoming>Flow_HitungOngkir_Pembayaran</bpmn:incoming>
      <bpmn:outgoing>Flow_Pembayaran_Paralel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_MulaiParalel" name="Mulai paralel">
      <bpmn:incoming>Flow_Pembayaran_Paralel</bpmn:incoming>
      <bpmn:outgoing>Flow_Paralel_Konfirmasi</bpmn:outgoing>
      <bpmn:outgoing>Flow_Paralel_CariDriver</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_KonfirmasiRestoran" name="Konfirmasi oleh Restoran" camunda:formRef="konfirmasi-restoran" camunda:formRefBinding="deployment" camunda:assignee="restoran">
      <bpmn:incoming>Flow_Paralel_Konfirmasi</bpmn:incoming>
      <bpmn:outgoing>Flow_Konfirmasi_GatewayRestoran</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RestoranHasil" name="Restoran menerima?" default="Flow_Restoran_Tidak">
      <bpmn:incoming>Flow_Konfirmasi_GatewayRestoran</bpmn:incoming>
      <bpmn:outgoing>Flow_Restoran_Diterima</bpmn:outgoing>
      <bpmn:outgoing>Flow_Restoran_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="BoundaryEvent_BatasWaktuRestoran" name="Timeout 5 menit" attachedToRef="Task_KonfirmasiRestoran">
      <bpmn:outgoing>Flow_Timeout_RestoranGagal</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_BatasWaktu">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CariDriver" name="Cari Driver" camunda:type="external" camunda:topic="cari-driver">
      <bpmn:incoming>Flow_Paralel_CariDriver</bpmn:incoming>
      <bpmn:outgoing>Flow_CariDriver_GatewayDriver</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_BatasWaktuDriver" name="Timeout 2 menit" attachedToRef="Task_CariDriver">
      <bpmn:outgoing>Flow_Timeout_DriverGagal</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_BatasWaktuDriver">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_DriverDitemukan" name="Driver ditemukan?" default="Flow_Driver_Tidak">
      <bpmn:incoming>Flow_CariDriver_GatewayDriver</bpmn:incoming>
      <bpmn:outgoing>Flow_Driver_Ditemukan</bpmn:outgoing>
      <bpmn:outgoing>Flow_Driver_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_TungguHasil" name="Keduanya siap">
      <bpmn:incoming>Flow_Restoran_Diterima</bpmn:incoming>
      <bpmn:incoming>Flow_Driver_Ditemukan</bpmn:incoming>
      <bpmn:outgoing>Flow_Hasil_Antar</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Gagal" name="Proses gagal">
      <bpmn:incoming>Flow_Restoran_Tidak</bpmn:incoming>
      <bpmn:incoming>Flow_Timeout_RestoranGagal</bpmn:incoming>
      <bpmn:incoming>Flow_Driver_Tidak</bpmn:incoming>
      <bpmn:incoming>Flow_Timeout_DriverGagal</bpmn:incoming>
      <bpmn:outgoing>Flow_Gagal_Refund</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AntarPesanan" name="Antar Pesanan" camunda:formRef="antar-pesanan" camunda:formRefBinding="deployment" camunda:assignee="driver">
      <bpmn:incoming>Flow_Hasil_Antar</bpmn:incoming>
      <bpmn:outgoing>Flow_Antar_Selesai</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_PesananSelesai" name="Pesanan Selesai">
      <bpmn:incoming>Flow_Antar_Selesai</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RefundPembayaran" name="Refund Pembayaran" camunda:type="external" camunda:topic="refund-pembayaran">
      <bpmn:incoming>Flow_Gagal_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_Batal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PesananDibatalkan" name="Pesanan Dibatalkan">
      <bpmn:incoming>Flow_Refund_Batal</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_PesananDibatalkan" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_HitungOngkir" sourceRef="StartEvent_CustomerPesan" targetRef="Task_HitungOngkir" />
    <bpmn:sequenceFlow id="Flow_HitungOngkir_Pembayaran" sourceRef="Task_HitungOngkir" targetRef="Task_ProsesPembayaran" />
    <bpmn:sequenceFlow id="Flow_Pembayaran_Paralel" sourceRef="Task_ProsesPembayaran" targetRef="Gateway_MulaiParalel" />
    <bpmn:sequenceFlow id="Flow_Paralel_Konfirmasi" sourceRef="Gateway_MulaiParalel" targetRef="Task_KonfirmasiRestoran" />
    <bpmn:sequenceFlow id="Flow_Paralel_CariDriver" sourceRef="Gateway_MulaiParalel" targetRef="Task_CariDriver" />
    <bpmn:sequenceFlow id="Flow_Konfirmasi_GatewayRestoran" sourceRef="Task_KonfirmasiRestoran" targetRef="Gateway_RestoranHasil" />
    <bpmn:sequenceFlow id="Flow_Restoran_Diterima" name="Ya" sourceRef="Gateway_RestoranHasil" targetRef="Gateway_TungguHasil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${diterimaRestoran == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Restoran_Tidak" name="Tidak" sourceRef="Gateway_RestoranHasil" targetRef="Gateway_Gagal" />
    <bpmn:sequenceFlow id="Flow_Timeout_RestoranGagal" sourceRef="BoundaryEvent_BatasWaktuRestoran" targetRef="Gateway_Gagal" />
    <bpmn:sequenceFlow id="Flow_CariDriver_GatewayDriver" sourceRef="Task_CariDriver" targetRef="Gateway_DriverDitemukan" />
    <bpmn:sequenceFlow id="Flow_Driver_Ditemukan" name="Ya" sourceRef="Gateway_DriverDitemukan" targetRef="Gateway_TungguHasil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${driverFound == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Driver_Tidak" name="Tidak" sourceRef="Gateway_DriverDitemukan" targetRef="Gateway_Gagal" />
    <bpmn:sequenceFlow id="Flow_Timeout_DriverGagal" sourceRef="BoundaryEvent_BatasWaktuDriver" targetRef="Gateway_Gagal" />
    <bpmn:sequenceFlow id="Flow_Hasil_Antar" sourceRef="Gateway_TungguHasil" targetRef="Task_AntarPesanan" />
    <bpmn:sequenceFlow id="Flow_Gagal_Refund" sourceRef="Gateway_Gagal" targetRef="Task_RefundPembayaran" />
    <bpmn:sequenceFlow id="Flow_Antar_Selesai" sourceRef="Task_AntarPesanan" targetRef="EndEvent_PesananSelesai" />
    <bpmn:sequenceFlow id="Flow_Refund_Batal" sourceRef="Task_RefundPembayaran" targetRef="EndEvent_PesananDibatalkan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PesanMakanan">
    <bpmndi:BPMNPlane id="BPMNPlane_PesanMakanan" bpmnElement="Collaboration_PesanMakanan">
      <bpmndi:BPMNShape id="Participant_PesanMakanan_di" bpmnElement="Participant_PesanMakanan" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1750" height="720" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Driver_di" bpmnElement="Lane_Driver" isHorizontal="true">
        <dc:Bounds x="180" y="570" width="1720" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Restoran_di" bpmnElement="Lane_Restoran" isHorizontal="true">
        <dc:Bounds x="180" y="420" width="1720" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistem_di" bpmnElement="Lane_Sistem" isHorizontal="true">
        <dc:Bounds x="180" y="200" width="1720" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="1720" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_CustomerPesan_di" bpmnElement="StartEvent_CustomerPesan">
        <dc:Bounds x="230" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="207" y="158" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HitungOngkir_di" bpmnElement="Task_HitungOngkir">
        <dc:Bounds x="350" y="275" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProsesPembayaran_di" bpmnElement="Task_ProsesPembayaran">
        <dc:Bounds x="510" y="275" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MulaiParalel_di" bpmnElement="Gateway_MulaiParalel" isMarkerVisible="true">
        <dc:Bounds x="680" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="674" y="345" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KonfirmasiRestoran_di" bpmnElement="Task_KonfirmasiRestoran">
        <dc:Bounds x="830" y="450" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RestoranHasil_di" bpmnElement="Gateway_RestoranHasil" isMarkerVisible="true">
        <dc:Bounds x="1060" y="465" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1057" y="436" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CariDriver_di" bpmnElement="Task_CariDriver">
        <dc:Bounds x="830" y="225" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DriverDitemukan_di" bpmnElement="Gateway_DriverDitemukan" isMarkerVisible="true">
        <dc:Bounds x="1060" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1032" y="215" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TungguHasil_di" bpmnElement="Gateway_TungguHasil" isMarkerVisible="true">
