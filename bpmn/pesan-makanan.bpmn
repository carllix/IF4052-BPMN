        <bpmndi:BPMNLabel>
          <dc:Bounds x="1209" y="273" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Gagal_di" bpmnElement="Gateway_Gagal" isMarkerVisible="true">
        <dc:Bounds x="1320" y="390" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1267" y="433" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AntarPesanan_di" bpmnElement="Task_AntarPesanan">
        <dc:Bounds x="1510" y="635" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PesananSelesai_di" bpmnElement="EndEvent_PesananSelesai">
        <dc:Bounds x="1710" y="657" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1680" y="700" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RefundPembayaran_di" bpmnElement="Task_RefundPembayaran">
        <dc:Bounds x="1510" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PesananDibatalkan_di" bpmnElement="EndEvent_PesananDibatalkan">
        <dc:Bounds x="1710" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1678" y="314" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_BatasWaktuDriver_di" bpmnElement="BoundaryEvent_BatasWaktuDriver">
        <dc:Bounds x="872" y="207" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="915" y="207" width="94" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_BatasWaktuRestoran_di" bpmnElement="BoundaryEvent_BatasWaktuRestoran">
        <dc:Bounds x="872" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="781" y="433" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_HitungOngkir_di" bpmnElement="Flow_Start_HitungOngkir">
        <di:waypoint x="266" y="140" />
        <di:waypoint x="310" y="140" />
        <di:waypoint x="310" y="315" />
        <di:waypoint x="350" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HitungOngkir_Pembayaran_di" bpmnElement="Flow_HitungOngkir_Pembayaran">
        <di:waypoint x="460" y="315" />
        <di:waypoint x="510" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Pembayaran_Paralel_di" bpmnElement="Flow_Pembayaran_Paralel">
        <di:waypoint x="620" y="315" />
        <di:waypoint x="680" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Paralel_Konfirmasi_di" bpmnElement="Flow_Paralel_Konfirmasi">
        <di:waypoint x="705" y="340" />
        <di:waypoint x="705" y="490" />
        <di:waypoint x="830" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Paralel_CariDriver_di" bpmnElement="Flow_Paralel_CariDriver">
        <di:waypoint x="730" y="315" />
        <di:waypoint x="780" y="315" />
        <di:waypoint x="780" y="265" />
        <di:waypoint x="830" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Konfirmasi_GatewayRestoran_di" bpmnElement="Flow_Konfirmasi_GatewayRestoran">
        <di:waypoint x="950" y="490" />
        <di:waypoint x="1060" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Restoran_Diterima_di" bpmnElement="Flow_Restoran_Diterima">
        <di:waypoint x="1110" y="490" />
        <di:waypoint x="1160" y="490" />
        <di:waypoint x="1160" y="315" />
        <di:waypoint x="1220" y="315" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1125" y="470" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Restoran_Tidak_di" bpmnElement="Flow_Restoran_Tidak">
        <di:waypoint x="1085" y="515" />
        <di:waypoint x="1085" y="545" />
        <di:waypoint x="1345" y="545" />
        <di:waypoint x="1345" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1095" y="520" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timeout_RestoranGagal_di" bpmnElement="Flow_Timeout_RestoranGagal">
        <di:waypoint x="890" y="432" />
        <di:waypoint x="890" y="390" />
        <di:waypoint x="1345" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CariDriver_GatewayDriver_di" bpmnElement="Flow_CariDriver_GatewayDriver">
        <di:waypoint x="950" y="265" />
        <di:waypoint x="1060" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Driver_Ditemukan_di" bpmnElement="Flow_Driver_Ditemukan">
        <di:waypoint x="1110" y="265" />
        <di:waypoint x="1195" y="265" />
        <di:waypoint x="1195" y="315" />
        <di:waypoint x="1220" y="315" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1140" y="245" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Driver_Tidak_di" bpmnElement="Flow_Driver_Tidak">
        <di:waypoint x="1085" y="290" />
        <di:waypoint x="1085" y="350" />
        <di:waypoint x="1295" y="350" />
        <di:waypoint x="1295" y="415" />
        <di:waypoint x="1320" y="415" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1097" y="311" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timeout_DriverGagal_di" bpmnElement="Flow_Timeout_DriverGagal">
        <di:waypoint x="872" y="225" />
        <di:waypoint x="800" y="225" />
        <di:waypoint x="800" y="370" />
        <di:waypoint x="1345" y="370" />
        <di:waypoint x="1345" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Hasil_Antar_di" bpmnElement="Flow_Hasil_Antar">
        <di:waypoint x="1270" y="315" />
        <di:waypoint x="1400" y="315" />
        <di:waypoint x="1400" y="675" />
        <di:waypoint x="1510" y="675" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gagal_Refund_di" bpmnElement="Flow_Gagal_Refund">
        <di:waypoint x="1370" y="415" />
        <di:waypoint x="1440" y="415" />
        <di:waypoint x="1440" y="290" />
        <di:waypoint x="1510" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Antar_Selesai_di" bpmnElement="Flow_Antar_Selesai">
